# Local-only values for host-native dev and P10 compose.
# Do not commit this file.

POSTGRES_DB=context_engine
POSTGRES_USER=context_engine
POSTGRES_PASSWORD=context_engine

# Host-native scripts/dev.sh only. Compose uses the internal postgres service.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5438

CE_ADMIN_USERNAME=admin
CE_ADMIN_PASSWORD=admin123

# Local HTTP smoke requires the session cookie to be sent over http://127.0.0.1.
CE_SESSION_COOKIE_SECURE=false

CONFIG_ENCRYPTION_KEY=OxkO5QTKDW-j04TghL7CGwFu7B_rKR7r_CjFBOAl0Us=

# Host-native dev uses localhost API. Compose overrides this to http://api:8000.
CONTEXT_ENGINE_API_BASE=http://127.0.0.1:8000

P10_API_PORT=8000
P10_FRONTEND_PORT=3000
